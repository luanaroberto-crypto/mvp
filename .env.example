# Copie este arquivo para .env e preencha com seus valores.
# O .env está no .gitignore e NUNCA deve ser commitado.

# Obrigatório — crie gratuitamente em https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=sua-chave-aqui

# Opcionais (valores padrão abaixo)
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=5.0
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=pt_br
